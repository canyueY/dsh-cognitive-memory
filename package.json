{
  "name": "dsh-mnemosyne",
  "version": "3.0.0",
  "description": "Mnemosyne 3.0：个人认知基础设施；DSH 插件适配层 + 独立 Python Node / Memory Bank",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "mnemosyne"
  ],
  "homepage": "https://github.com/canyueY/dsh-mnemosyne#readme",
  "bugs": {
    "url": "https://github.com/canyueY/dsh-mnemosyne/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyueY/dsh-mnemosyne.git"
  },
  "author": "canyueY",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/memory-client.js",
    "./tool-spec": "./src/tool-spec.js"
  },
  "files": [
    "src",
    "service",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION_3.0.md",
    "LICENSE",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test legacy/dsh-plugin/test/*.mjs src/test/*.mjs",
    "check": "node --check src/index.js && node --check src/memory-client.js && node --check src/memory-process.js && node --check src/tool-spec.js",
    "test:service": "python -m pytest service/tests -q"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
